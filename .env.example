# Copy to .env.local and fill in. Restart the server after saving.
# Do not commit .env.local.

# Inbox that receives each enquiry.
ENQUIRY_TO=you@gmail.com

# Gmail account that sends the mail. Use the 16-character app password, not your login password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="Bellevue by SOBHA <you@gmail.com>"
