# Copy to .env.local and fill in. Restart the server after saving.

# Inbox that receives each enquiry. Sign up for Resend with this same address.
ENQUIRY_TO=you@gmail.com

# Free API key from https://resend.com — no Gmail app password needed.
RESEND_API_KEY=re_your_key

# Optional. Leave unset until you verify your own domain in Resend.
# EMAIL_FROM="Bellevue by SOBHA <enquiries@yourdomain.com>"
